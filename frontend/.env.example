# Only needed for production builds where frontend and backend live on
# different domains (e.g. Vercel + Render). Leave unset for local dev —
# the Vite dev server proxy handles it instead.
VITE_API_BASE=https://your-backend-url.onrender.com/api
VITE_SUPABASE_URL = project url
VITE_SUPABASE_ANON_KEY= project anon key